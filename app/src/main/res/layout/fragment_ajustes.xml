<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:clipToPadding="false"
    android:focusable="true"
    android:paddingBottom="112dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_volver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_on_glass" />

            <TextView
                style="@style/Atmos.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Ajustes" />
        </LinearLayout>

        <!-- ═════════ Unidades ═════════ -->
        <TextView
            style="@style/Atmos.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Unidades" />

        <LinearLayout
            style="@style/Atmos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Atmos.TextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Temperatura" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupo_temp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_celsius"
                    style="@style/Atmos.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="°C  Celsius" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fahrenheit"
                    style="@style/Atmos.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="°F  Fahrenheit" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/Atmos.TextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Viento" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupo_viento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_kmh"
                    style="@style/Atmos.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="km/h" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mph"
                    style="@style/Atmos.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="mph" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ms"
                    style="@style/Atmos.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="m/s" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_24h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Formato de 24 horas"
                android:textColor="@color/text_on_glass"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ═════════ Fuentes ═════════ -->
        <TextView
            style="@style/Atmos.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Fuentes de datos" />

        <LinearLayout
            style="@style/Atmos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_openweather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comparar con OpenWeather"
                android:textColor="@color/text_on_glass"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_estado_fuentes"
                style="@style/Atmos.TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="" />
        </LinearLayout>

        <!-- ═════════ Notificaciones ═════════ -->
        <TextView
            style="@style/Atmos.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Notificaciones" />

        <LinearLayout
            style="@style/Atmos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_notif_diaria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumen diario del clima"
                android:textColor="@color/text_on_glass"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/fila_hora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_schedule"
                    app:tint="@color/text_on_glass_secondary" />

                <TextView
                    style="@style/Atmos.TextSecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Hora del resumen" />

                <TextView
                    android:id="@+id/tv_hora_notif"
                    style="@style/Atmos.TextPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="07:00" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="@color/divider_glass" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_notif_lluvia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alertas de lluvia"
                android:textColor="@color/text_on_glass"
                android:textSize="16sp" />

            <TextView
                style="@style/Atmos.TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Revisa cada 2 horas y te avisa si la probabilidad de lluvia en las próximas 3 horas es de 60 % o más (promedio de las dos fuentes)." />
        </LinearLayout>

        <!-- ═════════ Widgets ═════════ -->
        <TextView
            style="@style/Atmos.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Widgets" />

        <LinearLayout
            style="@style/Atmos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Atmos.TextSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agrega el clima a tu pantalla de inicio. Al colocarlo podrás elegir la ciudad (tu ubicación o un favorito). Se actualizan cada 30 minutos." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_widget_chico"
                    style="@style/Atmos.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="2×2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_widget_mediano"
                    style="@style/Atmos.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="4×2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_widget_grande"
                    style="@style/Atmos.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="4×4" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═════════ Acerca de ═════════ -->
        <LinearLayout
            style="@style/Atmos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                style="@style/Atmos.TextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Atmos 2.0" />

            <TextView
                style="@style/Atmos.TextSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Tópicos Avanzados de Programación · ITL\nDatos: OpenWeather y Open-Meteo (CC BY 4.0)" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
