<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <TextView
        style="@style/Atmos.ScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="Buscar" />

    <!-- Campo de búsqueda con autocompletado -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_buscar"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Ciudad, ej. Torreón"
        android:textColorHint="@color/text_on_glass_secondary"
        app:boxBackgroundColor="@color/glass"
        app:boxCornerRadiusBottomEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusTopStart="20dp"
        app:boxStrokeColor="@color/text_on_glass"
        app:endIconMode="clear_text"
        app:endIconTint="@color/text_on_glass"
        app:hintTextColor="@color/text_on_glass"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/text_on_glass">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_buscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColor="@color/text_on_glass" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_busqueda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/text_on_glass"
        app:trackColor="@color/glass" />

    <!-- Acceso rápido a la ubicación actual -->
    <LinearLayout
        android:id="@+id/btn_mi_ubicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_small"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_my_location"
            app:tint="@color/text_on_glass" />

        <TextView
            style="@style/Atmos.TextPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Usar mi ubicación actual" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_on_glass_tertiary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_search_hint"
        style="@style/Atmos.TextSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Escribe al menos 2 letras.\nPuedes buscar cualquier ciudad del mundo 🌎" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="112dp" />
</LinearLayout>
