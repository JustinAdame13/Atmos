<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2x2. Solo se pueden usar vistas compatibles con RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_clear_day"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_w_ciudad"
        style="@style/Atmos.Widget.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Torreón"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_w_temp"
            style="@style/Atmos.Widget.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:text="28°"
            android:textSize="42sp" />

        <ImageView
            android:id="@+id/iv_w_icono"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_weather_sunny" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_w_desc"
        style="@style/Atmos.Widget.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Despejado"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_w_maxmin"
        style="@style/Atmos.Widget.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.85"
        android:text="↑31°  ↓18°"
        android:textSize="12sp" />
</LinearLayout>
