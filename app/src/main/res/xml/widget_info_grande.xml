<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración del widget grande (4x4).
    updatePeriodMillis = 0 porque las actualizaciones las programa JobScheduler (cada 30 min).
    configure = pantalla para elegir la ciudad al colocar el widget.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.justin.atmos.widget.WidgetConfigActivity"
    android:description="@string/widget_large_desc"
    android:initialLayout="@layout/widget_grande"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="180dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_grande"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
